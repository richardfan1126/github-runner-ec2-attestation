# GitHub Actions Remote Executor Configuration
#
# NOTE: This file is an example/reference only. The actual configuration loaded
# at runtime lives in kiwi-descriptions/root/etc/github-actions-remote-executor/env
# (deployed to /etc/github-actions-remote-executor/env and loaded by systemd via
# EnvironmentFile=). Edit that file to change real settings.

# HTTP Server Configuration
SERVER_PORT=8080

# Execution Configuration
MAX_CONCURRENT_EXECUTIONS=10
EXECUTION_TIMEOUT_SECONDS=300
MAX_SCRIPT_SIZE_BYTES=1048576

# Rate Limiting Configuration
RATE_LIMIT_PER_IP=100
RATE_LIMIT_WINDOW_SECONDS=60

# Storage Configuration
TEMP_STORAGE_PATH=/tmp/gha-executor
OUTPUT_RETENTION_HOURS=24

# NitroTPM Configuration
TPM_ATTEST_PATH=/usr/bin/nitro-tpm-attest

# OIDC Authentication Configuration
ALLOWED_REPOSITORIES=owner/repo1,owner/repo2
EXPECTED_AUDIENCE=https://your-remote-executor.example.com

# Container Execution Configuration
CONTAINER_IMAGE=ubuntu:24.04
# REQUIRED: SHA-256 digest for container image verification (e.g., sha256:abc123...). Server will fail to start if this is empty and CONTAINER_IMAGE does not contain @sha256:.
CONTAINER_IMAGE_DIGEST=
CONTAINER_MEMORY_LIMIT=4g
CONTAINER_CPU_LIMIT=1.0

# Container Security Configuration
#
# All eight variables below default to the hardened (most secure) choice, so a
# no-config deployment runs every execution container locked down. Each variable
# is parsed and validated at startup; an invalid value makes the server fail
# fast before it binds its port, with an error naming the offending variable.
#
# ⚠️ BACKWARD-COMPATIBILITY: These hardened defaults are a deliberate breaking
# change. Workloads that previously assumed a writable rootfs, a root user,
# network egress, or extra capabilities will break until the relevant variable
# below is relaxed. Each variable documents the symptom and the change that
# restores the prior behavior.

# Container user as "uid:gid". Default is the unprivileged nobody:nogroup
# (65534:65534) so the workload never runs as root. To run as root you must set
# BOTH this to 0:0 and CONTAINER_ALLOW_ROOT=true (see below).
# Symptom if too strict: job needs to write to root-owned paths / install
#   packages → set CONTAINER_USER=0:0 and CONTAINER_ALLOW_ROOT=true.
CONTAINER_USER=65534:65534

# Explicit opt-in gate for running as root (uid 0). Default false. The server
# refuses to start if CONTAINER_USER resolves to uid 0 while this is false; the
# error names BOTH variables. Leave false unless a job genuinely requires root.
CONTAINER_ALLOW_ROOT=false

# Linux capabilities granted on top of cap_drop=ALL, comma-separated, case-
# sensitive, no CAP_ prefix. UNSET applies the default 7-cap working set
# (CHOWN,DAC_OVERRIDE,FOWNER,SETUID,SETGID,NET_BIND_SERVICE,KILL). An EMPTY value
# grants no capabilities at all. Only these 14 are permitted: CHOWN,
# DAC_OVERRIDE, FSETID, FOWNER, MKNOD, NET_RAW, SETGID, SETUID, SETFCAP,
# SETPCAP, NET_BIND_SERVICE, SYS_CHROOT, KILL, AUDIT_WRITE.
# Symptom if too strict: job fails on a permitted-but-not-default cap (e.g.
#   NET_RAW for ping) → add it, e.g. CONTAINER_CAP_ADD=CHOWN,DAC_OVERRIDE,NET_RAW.
# CONTAINER_CAP_ADD=

# Apply the no-new-privileges security option. Default true blocks setuid/setgid
# privilege escalation inside the container.
# Symptom if too strict: a tool relies on setuid (rare) → NO_NEW_PRIVILEGES=false.
NO_NEW_PRIVILEGES=true

# Mount the container root filesystem read-only. Default true; the writable
# scratch space is the /tmp tmpfs (see CONTAINER_TMPFS_SIZE).
# Symptom if too strict: job writes outside /tmp on the rootfs → set
#   CONTAINER_READ_ONLY_ROOTFS=false (prefer writing under /workspace or /tmp).
CONTAINER_READ_ONLY_ROOTFS=true

# Size of the writable /tmp tmpfs scratch mount (positive integer + unit
# b/k/m/g, e.g. "256m"). Default 256m. EMPTY means no tmpfs is mounted.
# Symptom if too strict: job needs more scratch space → raise it, e.g.
#   CONTAINER_TMPFS_SIZE=1g.
CONTAINER_TMPFS_SIZE=256m

# Bind mode for the /workspace volume: "ro" (read-only, default) or "rw".
# Symptom if too strict: job must modify checked-out files in place →
#   WORKSPACE_MOUNT_MODE=rw.
WORKSPACE_MOUNT_MODE=ro

# Container network mode: "none" (default, no network), "bridge", or "host".
# ⚠️ The default "none" breaks any job that needs outbound network access
#   (package installs, downloads, API calls).
# Symptom if too strict: job fails with DNS/connection errors → set
#   CONTAINER_NETWORK_MODE=bridge (or host) to restore network egress.
CONTAINER_NETWORK_MODE=none
