# Dockerfile for KIWI NG builder
# Based on Amazon Linux 2023
# Pinned versions for reproducible builds

FROM public.ecr.aws/amazonlinux/amazonlinux:2023.10.20260302.1

# Install system dependencies with exact versions
# See: https://docs.aws.amazon.com/AWSEC2/latest/UserGuide/build-sample-ami.html
RUN dnf install -y \
    kiwi-cli \
    python3-kiwi \
    kiwi-systemdeps-core \
    python3-poetry-core \
    qemu-img \
    veritysetup \
    erofs-utils \
    git \
    cargo \
    aws-nitro-tpm-tools \
    python3.11 \
    python3.11-pip \
    python3.11-devel \
    gcc \
    make \
    autoconf \
    automake \
    libtool \
    && dnf clean all

# Create output directory for build artifacts
RUN mkdir -p /output

# Set working directory
WORKDIR /workspace

# Default command (can be overridden)
CMD ["/bin/bash"]
