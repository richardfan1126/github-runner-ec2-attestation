# Dockerfile for KIWI NG builder
# Based on Amazon Linux 2023
# Pinned versions for reproducible builds

# Tag: 2023.10.20260302.1
FROM public.ecr.aws/amazonlinux/amazonlinux:2023.10.20260302.1@sha256:139c488a2b47155ccb61262cfe299509793a8edad74572473e14960630f1559a

# Lock DNF to the specific AL2023 release matching the base image.
# This ensures packages are resolved from the exact repository snapshot,
# preventing silent drift when repos are updated upstream.
RUN echo "2023.10.20260302" > /etc/dnf/vars/releasever

# Install system dependencies.
# DNF packages are installed without explicit NEVRA (Name-Epoch:Version-Release.Architecture)
# version pinning because Amazon Linux 2023 DNF repositories do not guarantee availability
# of specific package versions over time. The --releasever lock above mitigates this by
# pinning to a specific repository snapshot.
# See: https://docs.aws.amazon.com/AWSEC2/latest/UserGuide/build-sample-ami.html
RUN dnf install -y \
    kiwi-cli \
    python3-kiwi \
    kiwi-systemdeps-core \
    python3-poetry-core \
    qemu-img \
    veritysetup \
    erofs-utils \
    git \
    cargo \
    aws-nitro-tpm-tools \
    python3.11 \
    python3.11-pip \
    python3.11-devel \
    gcc \
    make \
    autoconf \
    automake \
    libtool \
    # Build-time dependencies for rootless Docker tools compiled from source.
    # golang: required for compiling rootlesskit (Go project).
    # glib2-devel, libcap-devel, libseccomp-devel: required for
    #   compiling slirp4netns (C/autotools, links against these libraries).
    # fuse3-devel: required for compiling fuse-overlayfs (C/autotools, links against libfuse3).
    # meson, ninja-build: required for building libslirp from source (not packaged in AL2023).
    golang \
    glib2-devel \
    libcap-devel \
    libseccomp-devel \
    fuse3-devel \
    meson \
    ninja-build \
    && dnf clean all

# Build and install libslirp from source.
# libslirp-devel is not available in AL2023 repositories, so we compile it.
# Required by slirp4netns for rootless networking.
# Uses a release tarball instead of git clone for resilience against transient
# GitLab server errors (HTTP 500) that can break CI builds.
# SHA-256 checksum verified to ensure tarball integrity.
ENV LIBSLIRP_SHA256="2a98852e65666db313481943e7a1997abff0183bd9bea80caec1b5da89fda28c"
RUN cd /tmp \
    && curl --retry 3 --retry-delay 5 -fsSL \
       "https://gitlab.freedesktop.org/slirp/libslirp/-/archive/v4.8.0/libslirp-v4.8.0.tar.gz" \
       -o libslirp.tar.gz \
    && echo "${LIBSLIRP_SHA256}  libslirp.tar.gz" | sha256sum -c - \
    && tar -xzf libslirp.tar.gz \
    && cd libslirp-v4.8.0 \
    && meson setup build \
    && ninja -C build \
    && ninja -C build install \
    && ldconfig \
    && rm -rf /tmp/libslirp-v4.8.0 /tmp/libslirp.tar.gz

# Create output directory for build artifacts
RUN mkdir -p /output

# Set working directory
WORKDIR /workspace

# Default command (can be overridden)
CMD ["/bin/bash"]
