<?xml version="1.0" encoding="utf-8"?>
<image schemaversion="7.5" name="github-actions-remote-executor">
    <description type="system">
        <author>GitHub Actions Remote Executor</author>
        <contact>https://github.com</contact>
        <specification>GitHub Actions Remote Executor Attestable Image</specification>
        <license>Apache License 2.0</license>
    </description>
    <preferences>
        <version>1.0.0</version>
        <packagemanager>dnf</packagemanager>
        <locale>en_US</locale>
        <keytable>us</keytable>
        <timezone>UTC</timezone>
        <rpm-check-signatures>true</rpm-check-signatures>
        <type
            image="oem"
            filesystem="xfs"
            kernelcmdline="console=ttyS0 rd.shell=0 systemd.getty_auto=false rd.kiwi.verity_options=panic-on-corruption"
            firmware="uefi"
            overlayroot="true"
            overlayroot_write_partition="false"
            overlayroot_readonly_filesystem="erofs"
            overlayroot_readonly_partsize="2048"
            erofscompression="lz4hc,level=12"
            eficsm="false"
            verity_blocks="all"
            bootpartition="false"
            efipartsize="200"
            editbootinstall="edit_boot_install.sh">
        <oemconfig>
            <oem-resize>false</oem-resize>
        </oemconfig>
        <bootloader name="systemd_boot" timeout="0"/>
        <initrd action="setup">
            <dracut uefi="true"/>
        </initrd>
        <size unit="G">4</size>
        </type>
    </preferences>

    <!-- AL2023 mirrorlist pinned to a specific release version for build reproducibility.
         Using a floating `latest` path would silently pull different package versions on
         each build, breaking reproducibility and making PCR measurements non-deterministic.
         To update: change the version below to the desired AL2023 release (e.g. 2023.6.x)
         and verify the new URL is reachable before committing. The version here should
         match the releasever set in .github/docker/Dockerfile.kiwi-builder. -->
    <repository priority="2" package_gpgcheck="true" sourcetype="mirrorlist" customize="add-gpg-key.sh">
            <source path="https://cdn.amazonlinux.com/al2023/core/mirrors/2023.10.20260302/$basearch/mirror.list"/>
    </repository>

    <!-- Package allow-list policy: Only packages with an explicit operational
         justification are permitted. Each package must have a comment documenting
         why it is required. Do not add packages for debugging, development, or
         operator convenience — the runtime image must remain minimal to reduce
         post-compromise attack surface. -->
    <packages type="image">
        <namedCollection name="core"/>
        <namedCollection name="ami-minimal"/>
        <package name="veritysetup"/>
        <package name="systemd-boot"/>
        <package name="zram-generator"/>
        <package name="zram-generator-defaults"/>
        <package name="cryptsetup"/>
        <package name="dracut-kiwi-verity"/>
        <package name="dracut-kiwi-overlay"/>
        <package name="aws-nitro-tpm-tools"/>
        <package name="systemd-resolved"/>
        <package name="amazon-chrony-config"/>
        <package name="python3.11"/>
        <package name="docker"/>
        <!-- Runtime library dependencies for source-compiled rootless Docker binaries
             (rootlesskit, slirp4netns, fuse-overlayfs are compiled from source in
             build-kiwi-image.sh because they are not available in AL2023 core repos).
             Note: uidmap (newuidmap/newgidmap) is provided by shadow-utils which is
             already included via the core collection.
             Note: libslirp is not packaged in AL2023; the shared library is copied
             from the builder container by build-kiwi-image.sh. -->
        <package name="fuse3"/>
        <package name="libseccomp"/>
        <package name="glib2"/>
        <package name="libcap"/>
        <!-- git: required by Repository_Client (src/repository.py) for cloning
             GitHub repositories containing scripts to execute -->
        <package name="git"/>
        <!-- binutils: required by dracut -uefi during the KIWI create step for UKI
             assembly (objcopy). Cannot be removed because pre_disk_sync.sh runs before
             dracut/UKI generation (not after), and there is no KIWI hook that runs
             after UKI assembly but before the root tree is written to disk. -->
        <package name="binutils"/>
        <!-- python3.11-pip: build-time dependency required by config.sh for
             'pip3.11 install'. Removed from the final runtime image by the
             <packages type="uninstall"> section below. -->
        <package name="python3.11-pip"/>
        <!-- Don't install these packages -->
        <ignore name="ec2-hibinit-agent"/>
        <ignore name="grubby"/>
        <ignore name="grub2-pc-modules"/>
        <ignore name="grub2-tools"/>
        <ignore name="grub2-efi-aa64-ec2"/>
        <ignore name="grub2-efi-aa64"/>
        <ignore name="grub2-efi-aa64-modules"/>
        <ignore name="grub2-efi-x64-ec2"/>
        <ignore name="grub2-efi-x64"/>
        <ignore name="grub2-efi-x64-modules"/>
        <ignore name="firewalld"/>
        <ignore name="amazon-linux-repo-s3"/>
        <ignore name="amazon-linux-repo-cdn"/>
        <!-- Remove operator access by not installing these packages -->
        <ignore name="openssh-server"/>
        <ignore name="amazon-ssm-agent"/>
        <ignore name="cloud-init"/>
        <ignore name="cloud-init-cfg-ec2"/>
        <ignore name="update-motd" />
        <ignore name="ec2-instance-connect"/>
    </packages>
    <!-- Build-time-only packages: KIWI processes the uninstall section after
         config.sh runs, so these packages are available during image configuration
         but absent from the final runtime image. This ensures build tools like pip
         do not increase the post-compromise attack surface. -->
    <packages type="uninstall">
        <package name="python3.11-pip"/>
    </packages>

    <packages type="bootstrap">
        <package name="system-release"/>
        <package name="dnf"/>
        <!-- Ignoring these packages forces the use of the minimal versions -->
        <ignore name="libcurl"/>
        <ignore name="curl"/>
        <ignore name="gnupg2"/>
    </packages>
</image>
