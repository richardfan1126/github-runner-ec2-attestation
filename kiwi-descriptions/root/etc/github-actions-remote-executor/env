# GitHub Actions Remote Executor Configuration
# This file is loaded by systemd via EnvironmentFile=

# HTTP Server Configuration
SERVER_PORT=8080

# Execution Configuration
MAX_CONCURRENT_EXECUTIONS=10
EXECUTION_TIMEOUT_SECONDS=300
MAX_SCRIPT_SIZE_BYTES=1048576

# Rate Limiting Configuration
RATE_LIMIT_PER_IP=100
RATE_LIMIT_WINDOW_SECONDS=60

# Storage Configuration
TEMP_STORAGE_PATH=/var/lib/gha-executor
OUTPUT_RETENTION_HOURS=24

# NitroTPM Configuration
TPM_ATTEST_PATH=/usr/bin/nitro-tpm-attest

# OIDC Authentication Configuration
ALLOWED_REPOSITORIES=richardfan1126/github-runner-ec2-attestation
EXPECTED_AUDIENCE=test-workflow

# Container Execution Configuration
CONTAINER_IMAGE=python:3.11-slim
CONTAINER_MEMORY_LIMIT=512m
CONTAINER_CPU_LIMIT=1.0
