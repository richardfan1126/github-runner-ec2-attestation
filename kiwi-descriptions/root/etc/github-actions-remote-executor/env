# GitHub Actions Remote Executor Configuration
# This file is loaded by systemd via EnvironmentFile=

# HTTP Server Configuration
SERVER_PORT=8080

# Execution Configuration
MAX_CONCURRENT_EXECUTIONS=10
EXECUTION_TIMEOUT_SECONDS=300
MAX_SCRIPT_SIZE_BYTES=1048576

# Rate Limiting Configuration
RATE_LIMIT_PER_IP=100
RATE_LIMIT_WINDOW_SECONDS=60

# Storage Configuration
TEMP_STORAGE_PATH=/var/lib/gha-executor
OUTPUT_RETENTION_HOURS=24

# NitroTPM Configuration
TPM_ATTEST_PATH=/usr/bin/nitro-tpm-attest

# OIDC Authentication Configuration
ALLOWED_REPOSITORIES=richardfan1126/github-runner-ec2-attestation-caller,richardfan1126/github-runner-ec2-attestation-rust-build-demo
EXPECTED_AUDIENCE=test-workflow

# Container Execution Configuration
CONTAINER_IMAGE=ubuntu:24.04
# REQUIRED: the linux/amd64 **manifest** digest of CONTAINER_IMAGE (the canonical
# anchor the baked sidecar is verified against). It MUST be the per-platform
# manifest digest, never a multi-arch index digest (D2 constraint 1) — the bake
# fails closed on an index. For ubuntu:24.04 this is the amd64 child of the index.
CONTAINER_IMAGE_DIGEST=sha256:cdb5fd928fced577cfecf12c8966e830fcdf42ee481fb0b91904eeddc2fe5eff
CONTAINER_MEMORY_LIMIT=4g
CONTAINER_CPU_LIMIT=1.0
